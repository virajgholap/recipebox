# Copy to .env.local for local development. Never commit .env.local.
#
# Both values come from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# The anon key is designed to be public — it ships in the JavaScript bundle and
# is visible to anyone. It is safe because row-level security decides what it
# can actually reach. See supabase/migrations/0001_init.sql.
#
# NEVER put the service_role key here. Anything prefixed VITE_ is compiled into
# the client bundle, and the service_role key bypasses row-level security
# entirely — publishing it hands over the whole database.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
